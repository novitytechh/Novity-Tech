# AI & Database Configuration for @hasaan_6/rag-chatbot-widget

# 1. Google Gemini API Key (Get free from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 3. Supabase Service Role Secret Key (Found in Supabase: Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
