# ------------------------------------------------------------------------------
# Option A: NEON Serverless Postgres (Recommended)
# ------------------------------------------------------------------------------
# From your Neon project dashboard (https://console.neon.tech):
# Copy your connection string from "Connection Details"
DATABASE_URL=postgresql://soft-hat-63021893_owner:YOUR_PASSWORD@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Option B: Supabase & Gemini Vector RAG
# ------------------------------------------------------------------------------
# 1. Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 3. Supabase Service Role Secret Key (Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
