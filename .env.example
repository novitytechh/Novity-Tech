# ==============================================================================
# Novity Tech - Chatbot Database & AI Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Option A: NEON Serverless Postgres (Recommended)
# ------------------------------------------------------------------------------
# From your Neon project dashboard (https://console.neon.tech):
# Copy your connection string from "Connection Details"
DATABASE_URL=postgresql://soft-hat-63021893_owner:YOUR_PASSWORD@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Option B: Supabase & Gemini Vector RAG
# ------------------------------------------------------------------------------
# 1. Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# 3. Supabase Service Role Secret Key (Settings -> API -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# Resend Email Configuration (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key_here
CONTACT_RECEIVER_EMAIL=novitytechh@gmail.com

# ------------------------------------------------------------------------------
# Slack Chatbot Adapter (@chat-adapter/slack)
# ------------------------------------------------------------------------------
# 1. Bot User OAuth Token from api.slack.com/apps -> OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# 2. Signing Secret from api.slack.com/apps -> Basic Information -> App Credentials
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# 3. Optional Bot Username
SLACK_BOT_NAME=novitybot

# ------------------------------------------------------------------------------
# Google Reviews (Google Places API - New)
# ------------------------------------------------------------------------------
# 1. Enable "Places API (New)" in Google Cloud Console and create an API key
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 2. Find your Place ID at https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=your_google_place_id_here
